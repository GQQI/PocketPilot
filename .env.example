# Copy to .env for local overrides. Never commit real keys.
# PocketPilot reads keys from the environment first, then from
# ~/.pocketpilot/secrets.json (mode 0600, outside the repo).

POCKETPILOT_HOME=
POCKETPILOT_PORT=47232
POCKETPILOT_STATIC=
# 127.0.0.1 keeps the host on this PC. npm run host sets 0.0.0.0 for the phone.
HOST=127.0.0.1

# Optional. Used only when demo mode is off and the matching CLI is launched.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
CURSOR_API_KEY=
OPENCODE_API_KEY=

# Remote pairing (QR + WebRTC), see docs/remote-pairing.md
# POCKETPILOT_RTC=1
# POCKETPILOT_REMOTE=1
# POCKETPILOT_PWA_URL=https://your-static-host/
# POCKETPILOT_ORIGINS=https://your-static-host
